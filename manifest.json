{
  "manifest_version": 3,
  "name": "Amazon Jobs \u2014 Public Signal Detector",
  "version": "0.6.1",
  "description": "Passive DOM-only Amazon Jobs detector; never auto-reloads listings pages.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Amazon Jobs Signal Detector",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://145-241-233-33.sslip.io/*",
    "https://*.jobsatamazon.co.uk/*",
    "https://jobsatamazon.co.uk/*",
    "https://*.amazon.jobs/*",
    "https://amazon.jobs/*",
    "https://*.jobs.amazon.co.uk/*",
    "https://jobs.amazon.co.uk/*",
    "https://*.hiring.amazon.com/*",
    "https://hiring.amazon.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.jobsatamazon.co.uk/*",
        "https://jobsatamazon.co.uk/*",
        "https://*.amazon.jobs/*",
        "https://amazon.jobs/*",
        "https://*.jobs.amazon.co.uk/*",
        "https://jobs.amazon.co.uk/*",
        "https://*.hiring.amazon.com/*",
        "https://hiring.amazon.com/*"
      ],
      "js": [
        "src/core.js",
        "src/availability.js",
        "src/safety.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
